local themeKeys = { "bg", "side", "card", "card2", "stroke", "accent", "accent2", "text", "sub", "icon", "selected", "off", "knobOff", "dim", "edge", "island" }
local baseKeys = { "bg", "side", "card", "card2", "stroke", "accent", "accent2", "text", "sub", "off", "knobOff", "dim", "edge", "island" }

local function dedupe(p)
	for i, k in ipairs(themeKeys) do
		for j = 1, i - 1 do
			local o = themeKeys[j]
			while p[k] == p[o] do
				local c = p[k]
				p[k] = Color3.new(c.R, c.G, c.B > 0.999 and c.B - 0.0004 or c.B + 0.0004)
			end
		end
	end
	return p
end

local function pal(t)
	local p = {}
	for i, k in ipairs(baseKeys) do
		local c = t[i]
		p[k] = Color3.fromRGB(c[1], c[2], c[3])
	end
	p.icon = p.sub
	p.selected = p.accent
	return dedupe(p)
end

