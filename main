local function buildIsland(W)
	local ui, c = W.ui, W.cfg
	local ic = c.Island
	local island = new("Frame", {
		Name = "Island",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -60),
		Size = UDim2.fromOffset(300, 34),
		BackgroundColor3 = T.island,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		ZIndex = 50,
	}, ui.gui)
	round(island, 17)
	stroke(island, T.edge, 0.82, 1)
	ui.island = island
	ui.islandScale = new("UIScale", { Scale = 1 }, island)
	ui.islandDot = new("Frame", {
		Position = UDim2.fromOffset(14, 13),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = T.sub,
		BorderSizePixel = 0,
		ZIndex = 51,
	}, island)
	round(ui.islandDot, 4)

	local function mkLabel(text, bold)
		return label(island, {
			Size = UDim2.fromOffset(40, 34),
			Text = text,
			TextSize = 12,
			Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
			TextColor3 = bold and T.accent2 or T.text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 51,
		})
	end

	local segs = {}
	local titleIcon = makeIcon(island, c.Icon, 14, T.accent2, { ZIndex = 51 })
	ui.islandTitleLabel = mkLabel(W.islandTitle, true)
	table.insert(segs, { icon = titleIcon, label = ui.islandTitleLabel, maxW = 110, show = true, font = Enum.Font.GothamBold })

	local userIcon = makeIcon(island, "user", 14, T.text, { ZIndex = 51 })
	table.insert(segs, { icon = userIcon, label = mkLabel(lp.DisplayName, false), maxW = 80, show = ic.ShowUser, font = Enum.Font.GothamMedium })

	local gameIcon = new("ImageLabel", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = T.off,
		BorderSizePixel = 0,
		Image = (game.GameId ~= 0) and ("rbxthumb://type=GameIcon&id=" .. game.GameId .. "&w=150&h=150") or "",
		ZIndex = 51,
	}, island)
	round(gameIcon, 4)
	local gameLabel = mkLabel(game.Name, false)
	table.insert(segs, { icon = gameIcon, label = gameLabel, maxW = 80, show = ic.ShowGame, font = Enum.Font.GothamMedium })

	local fpsIcon = makeIcon(island, "activity", 14, T.text, { ZIndex = 51 })
	local fpsLabel = mkLabel("0 fps", false)
	table.insert(segs, { icon = fpsIcon, label = fpsLabel, fixedW = 44, show = ic.ShowFPS, font = Enum.Font.GothamMedium })
	ui.fpsLabel = fpsLabel

	local seps = {}
	for i = 1, 3 do
		seps[i] = label(island, {
			Size = UDim2.fromOffset(6, 34),
			Text = "·",
			TextSize = 14,
			TextColor3 = T.sub,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 51,
		})
	end

	ui.islandLayout = function(animate)
		local function put(o, props)
			if animate then
				tw(o, props, 0.25)
			else
				for k, v in pairs(props) do
					o[k] = v
				end
			end
		end
		local x = 28
		local n = 0
		local sepIdx = 0
		for _, s in ipairs(segs) do
			s.icon.Visible = s.show
			s.label.Visible = s.show
			if s.show then
				n += 1
				if n > 1 then
					sepIdx += 1
					seps[sepIdx].Visible = true
					put(seps[sepIdx], { Position = UDim2.fromOffset(x + 1, 0) })
					x += 9
				end
				local w = s.fixedW
				if not w then
					local tx = TextService:GetTextSize(s.label.Text, 12, s.font, Vector2.new(1000, 34)).X
					w = math.clamp(math.ceil(tx) + 1, 12, s.maxW)
				end
				put(s.icon, { Position = UDim2.fromOffset(x, 10) })
				put(s.label, { Position = UDim2.fromOffset(x + 18, 0), Size = UDim2.fromOffset(w, 34) })
				x += 18 + w
			end
		end
		for i = sepIdx + 1, 3 do
			seps[i].Visible = false
		end
		put(island, { Size = UDim2.fromOffset(x + 10, 34) })
	end
	ui.islandLayout(false)

	gameLabel:GetPropertyChangedSignal("Text"):Connect(function()
		ui.islandLayout(true)
	end)
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(game.PlaceId)
		end)
		if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
			gameLabel.Text = info.Name
		end
	end)

	local btn = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 60,
	}, island)
	btn.MouseEnter:Connect(function()
		tw(ui.islandScale, { Scale = 1.04 }, 0.2)
	end)
	btn.MouseLeave:Connect(function()
		tw(ui.islandScale, { Scale = 1 }, 0.25)
	end)
	btn.MouseButton1Click:Connect(function()
		W:Toggle()
	end)
	tw(island, { Position = UDim2.new(0.5, 0, 0, 10) }, 0.7, Enum.EasingStyle.Back)
end

local function buildWatermark(W)
	W.ui.watermark = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -10),
		Size = UDim2.fromOffset(200, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = T.text,
		TextTransparency = W.cfg.WatermarkTransparency,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Visible = false,
		ZIndex = 5,
	}, W.ui.gui)
	W:SetWatermark(W.cfg.Watermark)
end

function UI:CreateWindow(cfg)
	if Active then
		Active:Destroy()
	end
	cfg = cfg or {}
	local c = {
		Title = "UI Library",
		Subtitle = "v" .. UI.Version,
		Icon = "terminal",
		ThemePreset = "graphite",
		ThemeName = "自定义",
		Transparent = true,
		BackgroundTransparency = 0.4,
		Blur = true,
		BlurSize = 14,
		Watermark = false,
		WatermarkTransparency = 0.5,
		ToggleKey = Enum.KeyCode.RightShift,
		Scale = 1,
		SaveConfig = true,
		ConfigFolder = "UILib",
		ShowProfile = true,
		AutoOpen = true,
	}
	for k, v in pairs(cfg) do
		c[k] = v
	end
	c.Island = { Enabled = true, ShowUser = true, ShowGame = true, ShowFPS = true }
	for k, v in pairs(cfg.Island or {}) do
		c.Island[k] = v
	end
	c.Strings = {
		Search = "搜索模块",
		NavTitle = "模块分类",
		ModuleCount = "%d 个模块",
		SearchResult = "搜索结果",
		Enabled = "已启用 %d 个模块",
		None = "None",
	}
	for k, v in pairs(cfg.Strings or {}) do
		c.Strings[k] = v
	end
	c.SidebarTransparency = cfg.SidebarTransparency or math.clamp(c.BackgroundTransparency - 0.12, 0, 1)
	c.CardTransparency = cfg.CardTransparency or math.clamp(c.BackgroundTransparency - 0.04, 0, 1)

	local base = themeById[c.ThemePreset] or Themes[1]
	local th = base
	if type(c.Theme) == "table" then
		th = UI:RegisterTheme("custom", c.ThemeName, c.Theme, base.id)
	end
	currentTheme = th.id
	applyPalette(th.p, true)

	saveOn = c.SaveConfig ~= false
	if saveOn then
		loadStore(c.ConfigFolder)
	end

	local W = setmetatable({
		cfg = c,
		S = c.Strings,
		Flags = {},
		pages = {},
		groups = {},
		ordered = {},
		binds = {},
		conns = {},
		themeMarks = {},
		ui = {},
		query = "",
		isOpen = false,
		token = 0,
		following = false,
		off = Vector2.new(0, 0),
		target = Vector2.new(0, 0),
		islandPos = UDim2.new(0.5, 0, 0, 27),
		islandFollow = cfg.IslandTitle == nil,
		islandTitle = cfg.IslandTitle or c.Title,
	}, Window)
	Active = W

	buildShell(W)
	buildSidebar(W)
	buildContent(W)
	if c.Island.Enabled then
		buildIsland(W)
	end
	buildWatermark(W)

	local acc, frames = 0, 0
	W:Connect(RunService.RenderStepped, function(dt)
		if W.following and W.isOpen then
			local d = W.target - W.off
			if d.Magnitude < 0.2 and not dragFn then
				W.off = W.target
				W.following = false
			else
				W.off = W.off + d * (1 - math.exp(-dt * 18))
			end
			W.ui.shell.Position = UDim2.new(0.5, W.off.X, 0.5, W.off.Y)
		end
		acc += dt
		frames += 1
		if acc >= 0.5 then
			if W.ui.fpsLabel then
				W.ui.fpsLabel.Text = math.floor(frames / acc + 0.5) .. " fps"
			end
			acc, frames = 0, 0
		end
	end)

	W:Connect(UserInputService.InputChanged, function(i)
		if not dragFn then
			return
		end
		if dragInput.UserInputType == Enum.UserInputType.Touch then
			if i == dragInput then
				dragFn(i.Position)
			end
		elseif i.UserInputType == Enum.UserInputType.MouseMovement then
			dragFn(i.Position)
		end
	end)

	W:Connect(UserInputService.InputEnded, function(i)
		if not dragInput then
			return
		end
		if dragInput.UserInputType == Enum.UserInputType.Touch then
			if i == dragInput then
				endDrag()
			end
		elseif i.UserInputType == Enum.UserInputType.MouseButton1 then
			endDrag()
		end
	end)

	W:Connect(UserInputService.InputBegan, function(i, gp)
		if W.listening and i.UserInputType == Enum.UserInputType.Keyboard then
			local f = W.listening
			W.listening = nil
			f(i.KeyCode)
			return
		end
		if gp then
			return
		end
		if W.cfg.ToggleKey and i.KeyCode == W.cfg.ToggleKey then
			W:Toggle()
			return
		end
		if i.UserInputType == Enum.UserInputType.Keyboard then
			for _, b in ipairs(W.binds) do
				if b.key and b.key == i.KeyCode and b.fire then
					b.fire()
				end
			end
		end
	end)

	W.ui.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		W.baseScale = W:_computeScale()
		if W.isOpen then
			tw(W.ui.scale, { Scale = W.baseScale }, 0.25)
		end
	end)

	if c.AutoOpen then
		task.delay(0.5, function()
			if Active == W and not W.isOpen then
				W:Open()
			end
		end)
	end

	return W
end

return UI
